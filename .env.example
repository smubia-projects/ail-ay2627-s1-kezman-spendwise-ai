# SpendWise AI API (server/, Cloud Run). Copy to .env for local dev (`npm run dev:server`).
# For deploys the whole file is uploaded as the DOTENV repo secret:
#   gh secret set DOTENV --repo smubia-projects/ail-ay2627-s1-kezman-spendwise-ai < .env
# Keep values on their own lines (no inline comments after a value).

# --- Inference (OpenAI-compatible chat completions) ---
# Gateway base URL. Default: apiyi.
API_BASE_URL=https://api.apiyi.com/v1
# This project's own key from the AI Lodge key bot. Empty = AI off (categorise falls back to keyword matching, insights answer 501).
API_KEY=
# Model for both AI steps (category suggestion and monthly insights).
MODEL_NAME=gemini-3.5-flash-lite
# The original OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL names are still read as fallbacks.

# --- CORS (required in production) ---
# Comma-separated frontend origins, e.g. the Vercel URL. Empty = allow any origin (local dev only).
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting (shared Upstash Redis; unset = limiting disabled) ---
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN come from the deploy kit's shared env.
# Fallback limits per IP per window; the central control sheet overrides them at runtime.
RATE_LIMIT_CATEGORIZE_MAX=10
RATE_LIMIT_INSIGHTS_MAX=5
RATE_LIMIT_WINDOW_SECONDS=432000

# PORT is injected by Cloud Run (defaults to 8080 locally).
