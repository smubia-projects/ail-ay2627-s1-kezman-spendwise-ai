{
  "name": "spendwise-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:server": "tsx watch --env-file-if-exists=.env server/server.ts",
    "build:server": "esbuild server/server.ts --bundle --platform=node --target=node22 --format=cjs --outfile=server/dist/server.js --log-level=warning",
    "start:server": "node server/dist/server.js",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs && tsx --test tests/server.test.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.40.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "openai": "^7.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
